# Copy to .env (which is gitignored) and choose your own values.
# Letters and digits only for the DB_* passwords (they pass through sed in docker/init/01-roles.sh).
# NEVER commit the real .env file.

DB_ADMIN_PASSWORD=ChangeMeAdmin1
DB_OWNER_PASSWORD=ChangeMeOwner1
DB_APP_PASSWORD=ChangeMeApp1
DB_READONLY_PASSWORD=ChangeMeRead1

# Signs the login tokens (JWT). At least 32 characters. Generate one with:
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9'
# The API refuses to start without it.
APP_AUTH_SECRET=ChangeThisToALongRandomStringOfAtLeast32Characters

# dev  = demo accounts and sample requests are loaded (db/dev/R__dev_seed.sql)
# prod = reference data only
SPRING_PROFILES_ACTIVE=dev

# Browser origins allowed to call the API when the frontend runs on its own server.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
